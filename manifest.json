{
  "schemaVersion": 1,
  "id": "io.github.heyimhere.hardware-panel",
  "name": "Hardware Panel",
  "version": "0.2.0",
  "author": "Ray Silvers",
  "license": "MIT",
  "description": "Discovers available CPU, GPU, memory, temperature, and fan sensors at runtime, with live Omarchy bar stats and a detailed hardware popup.",
  "kinds": ["service", "bar-widget"],
  "entryPoints": {
    "service": "HardwareService.qml",
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Hardware Panel",
    "description": "CPU/GPU utilization, temperatures, memory usage, and fan RPMs.",
    "category": "System",
    "aliases": ["hardware", "sensors"],
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "refreshIntervalSec": 2
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 1,
        "max": 30,
        "step": 1,
        "defaultValue": 2
      }
    ]
  }
}
